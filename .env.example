# Copy this file to .env and fill in your own values. .env is ignored by Git.
API_511_KEY=your-511-org-api-key
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_POSITIONS=vehicle-positions
MONGO_URI=mongodb://localhost:27017

# Secret salt for hashing vehicle IDs (B13). Everyone on the team must use the same value.
# Get it from Jason privately (never commit it). To generate a new one:
#   python -c "import secrets; print(secrets.token_hex(32))"
VEHICLE_ID_SALT=
